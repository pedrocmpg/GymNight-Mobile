# GymNight Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Supabase project URL (e.g. https://<your-project-ref>.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase JWT secret (found in Supabase dashboard → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Primary database connection string
DATABASE_URL=postgresql://db_user:db_password@db_host:5432/db_name

# Secret token used to authenticate requests to admin endpoints
ADMIN_SECRET=your-admin-secret-here

# Set to "true" to enable SlowAPI rate limiting on sync endpoints, "false" to disable
RATE_LIMIT_ENABLED=true

# Number of days to retain soft-deleted (tombstone) records before cleanup (1–3650)
TOMBSTONE_RETENTION_DAYS=90

# Application log level: DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO

# Database connection string used exclusively for integration tests
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/gymnight_test
