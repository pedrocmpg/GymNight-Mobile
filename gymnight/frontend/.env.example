# Configuração do Backend (Physical Device via USB)
# Para device via USB: use seu IP local (ex: 192.168.0.102)
# Para descobrir: $ hostname -I
# Device e PC devem estar na mesma rede WiFi
EXPO_PUBLIC_BACKEND_BASE_URL=http://192.168.0.102:8000

# Configuração do Supabase
# Obtenha em: https://app.supabase.com/project/{project}/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Debug flags (opcional)
EXPO_PUBLIC_DEBUG_SYNC=false
EXPO_PUBLIC_DEBUG_AUTH=false
EXPO_PUBLIC_DEBUG_DB=false
